# Pinned tool versions, sourced by the Makefile and scripts/ci-install-tools.sh.
STATICCHECK_VERSION=v0.8.2
GOVULNCHECK_VERSION=v1.9.0
YAMLLINT_VERSION=1.37.1
# Integration tests (test/integration/run.sh, make integration); looked up 2026-11-04.
# kind node image: the kind v0.30.0 default for Kubernetes v1.34.0 (same pin as the sibling
# fleet-in-a-repo project); digest = RepoDigest docker reports for kindest/node:v1.34.0.
KIND_VERSION=0.30.0
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
# Flux: the per-controller manifests of the official v2.2.3 release (manifests.tar.gz). Its
# sha256 is the value listed in flux_2.2.3_checksums.txt of the GitHub release (fetched over TLS
# 2026-11-04, equal to the sha256 of the downloaded asset); run.sh verifies the download against it.
FLUX_VERSION=2.2.3
FLUX_MANIFESTS_SHA256=a9ea4d2d7fec0e57d053834780811be46e009ec1b46f2925e66ad50948be504c
# Controller images of FLUX_VERSION's manifests, pinned by index digest
# (docker buildx imagetools inspect <image>:<tag>, 2026-11-04).
FLUX_SOURCE_CONTROLLER_IMAGE=fluxcd/source-controller:v1.2.4@sha256:34106b52d88d67d2889fabd2df19682dda30f32030488c9ae5c72e26239080fb
FLUX_KUSTOMIZE_CONTROLLER_IMAGE=fluxcd/kustomize-controller:v1.2.2@sha256:2df190255fc09131412472b900524c5c72a43464b3c2e99163c1ee143c5c2e22
FLUX_HELM_CONTROLLER_IMAGE=fluxcd/helm-controller:v0.37.4@sha256:6280691e55935f0f72cce166c63c0bc1208e68e1e048cf086a2e03d2ed6e2637
# Fixture image (test/integration/fixtures), index digest from docker buildx imagetools inspect.
BUSYBOX_IMAGE=busybox:1.36.1@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662

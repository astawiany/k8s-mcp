# Pinned tool versions, sourced by the Makefile and scripts/ci-install-tools.sh.
STATICCHECK_VERSION=v0.8.2
GOVULNCHECK_VERSION=v1.9.0
YAMLLINT_VERSION=1.37.1
# Integration tests (test/integration/run.sh, make integration); looked up 2026-11-04.
# kind node image: the kind v0.30.0 default for Kubernetes v1.34.0 (same pin as the sibling
# fleet-in-a-repo project); digest = RepoDigest docker reports for kindest/node:v1.34.0.
KIND_VERSION=0.30.0
# sha256 of kind-linux-amd64 from https://github.com/kubernetes-sigs/kind/releases/download/v0.30.0/kind-linux-amd64.sha256sum (2026-11-04).
KIND_SHA256_LINUX_AMD64=517ab7fc89ddeed5fa65abf71530d90648d9638ef0c4cde22c2c11f8097b8889
KIND_NODE_IMAGE=kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
# Flux: the per-controller manifests of the official v2.2.3 release (manifests.tar.gz). Its
# sha256 is the value listed in flux_2.2.3_checksums.txt of the GitHub release (fetched over TLS
# 2026-11-04, equal to the sha256 of the downloaded asset); run.sh verifies the download against it.
FLUX_VERSION=2.2.3
FLUX_MANIFESTS_SHA256=a9ea4d2d7fec0e57d053834780811be46e009ec1b46f2925e66ad50948be504c
# Controller images of FLUX_VERSION, pinned by index digest on ghcr.io (the registry of the
# release's install.yaml; manifests.tar.gz names them fluxcd/<name>:<tag>, run.sh rewrites both
# spellings). Tags: source-controller v1.2.4, kustomize-controller v1.2.2, helm-controller v0.37.4;
# digests from docker buildx imagetools inspect ghcr.io/fluxcd/<name>:<tag> (2026-11-04).
FLUX_SOURCE_CONTROLLER_IMAGE=ghcr.io/fluxcd/source-controller@sha256:34106b52d88d67d2889fabd2df19682dda30f32030488c9ae5c72e26239080fb
FLUX_KUSTOMIZE_CONTROLLER_IMAGE=ghcr.io/fluxcd/kustomize-controller@sha256:2df190255fc09131412472b900524c5c72a43464b3c2e99163c1ee143c5c2e22
FLUX_HELM_CONTROLLER_IMAGE=ghcr.io/fluxcd/helm-controller@sha256:6280691e55935f0f72cce166c63c0bc1208e68e1e048cf086a2e03d2ed6e2637
# Fixture image (test/integration/fixtures), index digest from docker buildx imagetools inspect.
BUSYBOX_IMAGE=busybox:1.36.1@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662
# kubectl for CI (scripts/ci-install-tools.sh kubectl); matches the kind node's Kubernetes version.
# sha256 of linux/amd64 kubectl from the official https://dl.k8s.io/release/v1.34.0/bin/linux/amd64/kubectl.sha256
# (fetched 2026-11-04); the installer verifies the download against it.
KUBECTL_VERSION=1.34.0
KUBECTL_SHA256_LINUX_AMD64=cfda68cba5848bc3b6c6135ae2f20ba2c78de20059f68789c090166d6abc3e2c
# CI toolchain pins (scripts/ci-install-tools.sh go|trivy|actionlint); looked up 2026-11-04. Each
# sha256 is for the linux/amd64 archive and is verified before install. A test keeps GO_VERSION equal
# to the toolchain line of go.mod (the go line stays the language floor).
# Go: latest 1.26 patch on 2026-11-04 (govulncheck checks the stdlib of the toolchain it runs on, so
# CI must not build with an old patch); sha256 from https://go.dev/dl/?mode=json&include=all
# (go1.26.10.linux-amd64.tar.gz).
GO_VERSION=1.26.10
GO_SHA256_LINUX_AMD64=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5
# Trivy: v0.76.1 (released 2026-10-21, same pin as the sibling project); sha256 of
# trivy_0.76.1_Linux-64bit.tar.gz from the release's trivy_0.76.1_checksums.txt.
TRIVY_VERSION=0.76.1
TRIVY_SHA256_LINUX_AMD64=c7cbe3137fb8a48a17574bede3dd6beb16742d1e9772929940fc90082c39d9c0
# actionlint: v1.7.12 (released 2026-03-30); sha256 of actionlint_1.7.12_linux_amd64.tar.gz from the
# release's actionlint_1.7.12_checksums.txt.
ACTIONLINT_VERSION=1.7.12
ACTIONLINT_SHA256_LINUX_AMD64=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
# Release tooling (.github/workflows/release.yml), same pins as the sibling project fleet-in-a-repo,
# re-checked read-only 2026-11-04. cosign v3.1.4 (released 2026-10-20): ci-install-tools.sh requires the
# downloaded cosign-linux-amd64 to match both this pin and the release's cosign_checksums.txt; the pin
# equals the asset digest GitHub reports (gh api repos/sigstore/cosign/releases/tags/v3.1.4).
COSIGN_VERSION=3.1.4
COSIGN_SHA256_LINUX_AMD64=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
# BuildKit for release.yml's docker-container buildx builder (attestations need it), pinned by index
# digest (docker buildx imagetools inspect moby/buildkit:v0.34.1).
BUILDKIT_IMAGE=moby/buildkit:v0.34.1@sha256:99368f3e46177c6405b9740e4461d91cee004128daeecca78d4ceac50ec1da5c
# SBOM generator BuildKit runs for --sbom; the default would be the floating stable-1 tag. Pinned by
# index digest (docker buildx imagetools inspect docker/buildkit-syft-scanner:1.12.1).
SBOM_GENERATOR_IMAGE=docker/buildkit-syft-scanner:1.12.1@sha256:873a7458c3c8ac8e32c7b796c10e1600b07b963d2aa000a72a2d97aaaa2d6315
